    NSColor,
    NSFont,
    NSFontAttributeName,
    NSForegroundColorAttributeName,
    NSPasteboard,
    NSPasteboardTypeString
)

__version__ = "0.2.1"

DB_PATH = os.path.expanduser("~/.gemini/antigravity/conversation_summaries.db")
BRAIN_DIR = os.path.expanduser("~/.gemini/antigravity/brain")

STRINGS = {
    "zh": {
        "untitled_convo": "未命名会话",
        "no_active_convo": "无活跃会话",
        "no_active_dialog": "暂无活跃 Antigravity 对话",
        "switch_convo": "切换跟踪会话",
        "auto_track": "自动跟踪最新活跃会话",
        "copy_convo_id": "复制会话 ID",
        "open_finder": "在 Finder 中打开日志",
        "refresh_now": "立即刷新",
        "language_menu": "语言 / Language",
        "lang_auto": "跟随系统 (Auto)",
        "lang_zh": "简体中文",
        "lang_en": "English",
        "quit": "退出",
        "label_prompt_cache": "提示词缓存",
        "label_turn_input": "本轮输入",
        "label_last_output": "上轮输出",
        "label_headroom": "剩余空间",
        "label_total_steps": "执行步数",
        "label_active_model": "当前模型",
    },
    "en": {
        "untitled_convo": "Untitled Conversation",
        "no_active_convo": "No Active Conversation",
        "no_active_dialog": "No active Antigravity conversations",
        "switch_convo": "Switch Conversation",
        "auto_track": "Auto-track latest active session",
        "copy_convo_id": "Copy Conversation ID",
        "open_finder": "Reveal Logs in Finder",
        "refresh_now": "Refresh Now",
        "language_menu": "Language / 语言",
        "lang_auto": "System Default (Auto)",
        "lang_zh": "简体中文",
        "lang_en": "English",
        "quit": "Quit",
        "label_prompt_cache": "Prompt Cache",
        "label_turn_input": "Turn Input",
        "label_last_output": "Last Output",
        "label_headroom": "Headroom Left",
        "label_total_steps": "Total Steps",
        "label_active_model": "Active Model",
    }
}


def str_display_width(s):
    """Calculates terminal/monospaced visual width taking CJK characters into account."""
    return sum(2 if unicodedata.east_asian_width(c) in ("F", "W") else 1 for c in s)


def pad_label(label, target_width=16):
    """Pads string to target visual width for clean column alignment."""
    w = str_display_width(label)
    return label + (" " * max(0, target_width - w))

MODEL_CHANGE_RE = re.compile(
    r"changed setting `Model Selection` from .*? to (.+?)\. No need to comment"
)


def infer_context_limit(model_name):
    """Infers the context window limit based on the active model name."""
    if not model_name:
        return 1000000
    low = model_name.lower()
    if "claude" in low:
        return 200000
    if "gpt-oss" in low or "gpt-4" in low:
        return 128000
    return 1000000


def format_limit_short(limit):
    if limit >= 1000000:
        return f"{limit // 1000000}M"
    return f"{limit // 1000}k"


def create_ring_icon(percent):
    """Draws a crisp Retina-ready circular progress ring matching macOS menu bar styling."""
    size = NSMakeSize(18, 18)
    img = NSImage.alloc().initWithSize_(size)
    img.lockFocus()

    rect = NSMakeRect(2.5, 2.5, 13.0, 13.0)
    center = NSMakePoint(9.0, 9.0)
    radius = 6.5

    # Background track (muted grey ring)
    bg_path = NSBezierPath.bezierPathWithOvalInRect_(rect)
    bg_path.setLineWidth_(2.0)
    NSColor.colorWithWhite_alpha_(0.5, 0.28).setStroke()
    bg_path.stroke()

    # Progress arc
    if percent > 0.05:
        arc_path = NSBezierPath.bezierPath()
        arc_path.setLineWidth_(2.0)
        start_angle = 90.0
        clamped_pct = min(max(percent, 0.0), 100.0)
        end_angle = 90.0 - (clamped_pct * 360.0 / 100.0)
        arc_path.appendBezierPathWithArcWithCenter_radius_startAngle_endAngle_clockwise_(
            center, radius, start_angle, end_angle, True
        )
        if clamped_pct < 60.0:
            NSColor.systemGreenColor().setStroke()
        elif clamped_pct < 85.0:
            NSColor.systemOrangeColor().setStroke()
        else:
            NSColor.systemRedColor().setStroke()
        arc_path.stroke()

    img.unlockFocus()
    return img


def make_kv_attributed_string(label, value, value_color=None):
    """Creates a cleanly aligned monospaced key-value NSAttributedString for NSMenuItem."""
    mono_font = NSFont.monospacedSystemFontOfSize_weight_(12.0, 0.0)
    bold_mono_font = NSFont.monospacedSystemFontOfSize_weight_(12.0, 0.25)

    label_padded = pad_label(label, 16)
    result = NSMutableAttributedString.alloc().init()

    label_attrs = {
        NSFontAttributeName: mono_font,
        NSForegroundColorAttributeName: NSColor.secondaryLabelColor()
    }
    val_attrs = {
        NSFontAttributeName: bold_mono_font,
        NSForegroundColorAttributeName: value_color or NSColor.labelColor()
    }

    result.appendAttributedString_(
        NSAttributedString.alloc().initWithString_attributes_(label_padded, label_attrs)
    )
    result.appendAttributedString_(
        NSAttributedString.alloc().initWithString_attributes_(value, val_attrs)
    )
    return result


class AntigravityMenuBarApp(NSObject):
    def init(self):
        self = objc.super(AntigravityMenuBarApp, self).init()
        if self is None:
            return None
        self.status_item = None
        self.menu = None
        self.timer = None
        self.pinned_convo_id = None
        self.pinned_convo_title = None
        self.current_stats = None
        self.recent_conversations = []
        self.is_menu_open = False
        self.last_signature = None
        self.last_icon_bucket = None
        self.lang_mode = "auto"
        try:
            saved_lang = NSUserDefaults.standardUserDefaults().stringForKey_("agy_language")
            if saved_lang in ("auto", "zh", "en"):
                self.lang_mode = str(saved_lang)
        except Exception:
            pass
        return self

    @objc.python_method
    def get_effective_lang(self):
        if self.lang_mode in ("zh", "en"):
            return self.lang_mode
        try:
            pref = NSLocale.preferredLanguages()
            if pref and str(pref[0]).lower().startswith("zh"):
                return "zh"
        except Exception:
            pass
        return "en"

    @objc.python_method
    def t(self, key):
        lang = self.get_effective_lang()
        return STRINGS.get(lang, STRINGS["en"]).get(key, key)

    def applicationDidFinishLaunching_(self, notification):
        # Set accessory mode (no Dock icon)
        NSApp.setActivationPolicy_(2)

        self.status_item = NSStatusBar.systemStatusBar().statusItemWithLength_(NSVariableStatusItemLength)
        self.menu = NSMenu.alloc().init()
        self.menu.setDelegate_(self)
        self.status_item.setMenu_(self.menu)

        # Use monospaced digits on status bar button to prevent width jitter
        btn = self.status_item.button()
        btn.setFont_(NSFont.monospacedDigitSystemFontOfSize_weight_(12.5, 0.0))
        btn.setImage_(create_ring_icon(0))
        btn.setTitle_(" --")

        # Initial refresh
        self.refreshData(force=True)

        # Setup persistent timer in Common Modes
        self.timer = NSTimer.timerWithTimeInterval_target_selector_userInfo_repeats_(
            1.5, self, "onTimerTick:", None, True
        )
        NSRunLoop.currentRunLoop().addTimer_forMode_(self.timer, "kCFRunLoopCommonModes")

    def menuWillOpen_(self, menu):
        self.is_menu_open = True
        self.refreshData(force=True, rebuild_menu_now=True)

    def menuDidClose_(self, menu):
        self.is_menu_open = False

    def onTimerTick_(self, timer):
        self.refreshData(force=False)

    @objc.python_method
    def fetchRecentConversations(self):
        convos = []
        if not os.path.exists(DB_PATH):
            return convos
        try:
            conn = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True, timeout=1.0)
            cur = conn.cursor()
            cur.execute("""
                SELECT conversation_id, title, last_modified_time, step_count 
                FROM conversation_summaries 
                ORDER BY last_modified_time DESC 
                LIMIT 8
            """)
            for row in cur.fetchall():
                convos.append({
                    "id": row[0],
                    "title": row[1] if row[1] else self.t("untitled_convo"),
                    "mtime": row[2],
                    "step_count": row[3]
                })

            # If pinned conversation is not in top 8, fetch its title directly
            if self.pinned_convo_id and not any(c["id"] == self.pinned_convo_id for c in convos):
                cur.execute(
                    "SELECT title FROM conversation_summaries WHERE conversation_id = ?",
                    (self.pinned_convo_id,)
                )
                prow = cur.fetchone()
                if prow and prow[0]:
                    self.pinned_convo_title = prow[0]

            conn.close()
        except Exception:
            pass
        return convos

    @objc.python_method
    def parseTranscript(self, convo_id):
        transcript_file = os.path.join(BRAIN_DIR, convo_id, ".system_generated", "logs", "transcript.jsonl")
        if not os.path.exists(transcript_file):
            return None

        last_model_step = None
        active_model = "Gemini 3.8 Flash"
        total_steps = 0

        try:
            with open(transcript_file, "r", encoding="utf-8") as f:
                for line in f:
                    if not line.strip():
                        continue
                    total_steps += 1
                    # Fast pre-filter before full JSON parsing when scanning
                    if '"input_tokens"' in line or "Model Selection" in line:
                        try:
                            s = json.loads(line)
                            if s.get("source") == "MODEL" and "input_tokens" in s:
                                last_model_step = s
                            elif s.get("type") == "USER_INPUT":
                                content = s.get("content", "")
                                m = MODEL_CHANGE_RE.search(content)
                                if m:
                                    active_model = m.group(1).strip()
                        except Exception:
                            pass
        except Exception:
            return None

        if last_model_step:
            inp = last_model_step.get("input_tokens", 0)
            cache = last_model_step.get("cache_read_tokens", 0)
            out = last_model_step.get("output_tokens", 0)
            total = inp + cache
            limit = infer_context_limit(active_model)
            pct = round(total / limit * 100, 1)
            return {
                "convo_id": convo_id,
                "file": transcript_file,
                "input_tokens": inp,
                "cache_tokens": cache,
                "output_tokens": out,
                "total_tokens": total,
                "total_steps": total_steps,
                "model": active_model,
                "limit": limit,
                "percent": pct
            }
        return None

    @objc.python_method
    def refreshData(self, force=False, rebuild_menu_now=False):
        convos = self.fetchRecentConversations()
        self.recent_conversations = convos

        target_convo_id = None
        target_title = self.t("no_active_convo")

        if self.pinned_convo_id:
            target_convo_id = self.pinned_convo_id
            target_title = self.pinned_convo_title or self.pinned_convo_id[:12]
            for c in convos:
                if c["id"] == self.pinned_convo_id:
                    target_title = c["title"]
                    self.pinned_convo_title = target_title
                    break
        elif convos:
            target_convo_id = convos[0]["id"]
            target_title = convos[0]["title"]

        # Check file stat fingerprint to avoid redundant parsing & UI redraws when idle
        t_mtime = 0
        t_size = 0
        if target_convo_id:
            t_file = os.path.join(BRAIN_DIR, target_convo_id, ".system_generated", "logs", "transcript.jsonl")
            try:
                st = os.stat(t_file)
                t_mtime = st.st_mtime_ns
                t_size = st.st_size
            except OSError:
                pass

        convos_sig = tuple((c["id"], c["title"], c["step_count"]) for c in convos)
        signature = (target_convo_id, self.pinned_convo_id, t_mtime, t_size, self.get_effective_lang(), convos_sig)

        if not force and signature == self.last_signature:
            return

        self.last_signature = signature

        stats = None
        if target_convo_id and t_size > 0:
            stats = self.parseTranscript(target_convo_id)
            if stats:
                stats["title"] = target_title

        self.current_stats = stats
        self.updateStatusBarDisplay(stats)

        # Do not destroy/rebuild menu while user is actively browsing an open menu/submenu
        # unless triggered directly by menuWillOpen_ or a user click action
        if not self.is_menu_open or rebuild_menu_now:
            self.rebuildMenu(stats, convos)

    @objc.python_method
    def updateStatusBarDisplay(self, stats):
        if not stats:
            self.status_item.button().setImage_(create_ring_icon(0))
            self.status_item.button().setTitle_(" --")
            self.last_icon_bucket = 0
            return

        pct = stats["percent"]
        total = stats["total_tokens"]
        if total >= 1000000:
            token_str = f" {total/1000000:.2f}M"
        else:
            token_str = f" {total/1000:.1f}k"

        # Redraw ring icon only when visual bucket changes (every 0.5%)
        icon_bucket = int(round(pct * 2))
        if icon_bucket != self.last_icon_bucket:
            self.status_item.button().setImage_(create_ring_icon(pct))
            self.last_icon_bucket = icon_bucket

        self.status_item.button().setTitle_(token_str)

    @objc.python_method
    def rebuildMenu(self, stats, convos):
        self.menu.removeAllItems()

        # Section 1: Active Conversation Header
        if stats:
            title_text = stats["title"]
            if len(title_text) > 30:
                title_text = title_text[:29] + "…"

            header_item = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_("", None, "")
            header_attrs = {
                NSFontAttributeName: NSFont.boldSystemFontOfSize_(13.0),
                NSForegroundColorAttributeName: NSColor.labelColor()
            }
            header_item.setAttributedTitle_(
                NSAttributedString.alloc().initWithString_attributes_(title_text, header_attrs)
            )
            header_item.setEnabled_(False)
            self.menu.addItem_(header_item)

            # ASCII Progress Bar
            pct = stats["percent"]
            bar_len = 12
            filled_len = min(max(int(round(bar_len * pct / 100)), 0), bar_len)
            bar_str = "■" * filled_len + "□" * (bar_len - filled_len)
            limit_short = format_limit_short(stats["limit"])
            progress_str = f"[{bar_str}] {pct:.1f}% ({stats['total_tokens']:,} / {limit_short})"

            progress_item = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_("", None, "")
            prog_attrs = {
                NSFontAttributeName: NSFont.monospacedSystemFontOfSize_weight_(11.5, 0.0),
                NSForegroundColorAttributeName: NSColor.secondaryLabelColor()
            }
            progress_item.setAttributedTitle_(
                NSAttributedString.alloc().initWithString_attributes_(progress_str, prog_attrs)
            )
            progress_item.setEnabled_(False)
            self.menu.addItem_(progress_item)

            self.menu.addItem_(NSMenuItem.separatorItem())

            # Section 2: Detailed Token Breakdown (Crisp Monospaced Key-Value)
            cache_pct = round(stats["cache_tokens"] / max(stats["total_tokens"], 1) * 100, 1)
            for label, val, color in [
                (self.t("label_prompt_cache"), f"{stats['cache_tokens']:,} ({cache_pct}%)", None),
                (self.t("label_turn_input"), f"{stats['input_tokens']:,}", None),
                (self.t("label_last_output"), f"{stats['output_tokens']:,}", None),
                (self.t("label_headroom"), f"{max(stats['limit'] - stats['total_tokens'], 0):,} ({max(100.0 - pct, 0.0):.1f}%)", NSColor.systemGreenColor() if pct < 60 else None),
                (self.t("label_total_steps"), f"{stats['total_steps']}", None),
                (self.t("label_active_model"), f"{stats['model']}", None),
            ]:
                row_item = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_("", None, "")
                row_item.setAttributedTitle_(make_kv_attributed_string(label, val, color))
                row_item.setEnabled_(False)
                self.menu.addItem_(row_item)
        else:
            no_item = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
                self.t("no_active_dialog"), None, ""
            )
            no_item.setEnabled_(False)
            self.menu.addItem_(no_item)

        self.menu.addItem_(NSMenuItem.separatorItem())

        # Section 3: Switch / Pin Conversation Submenu
        switch_menu = NSMenu.alloc().init()
        switch_parent = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            self.t("switch_convo"), None, ""
        )
        switch_parent.setSubmenu_(switch_menu)
        self.menu.addItem_(switch_parent)

        # Option: Auto-track latest
        auto_item = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            self.t("auto_track"), "selectAutoTrack:", ""
        )
        auto_item.setTarget_(self)
        if self.pinned_convo_id is None:
            auto_item.setState_(1)  # Checked
        switch_menu.addItem_(auto_item)
        switch_menu.addItem_(NSMenuItem.separatorItem())

        # List individual recent conversations
        for idx, c in enumerate(convos):
            cid = c["id"]
            ctitle = c["title"] if c["title"] else cid[:12]
            if len(ctitle) > 26:
                ctitle = ctitle[:25] + "…"
            c_item = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
                ctitle, "selectConvo:", ""
            )
            c_item.setRepresentedObject_(cid)
            c_item.setTarget_(self)
            if self.pinned_convo_id == cid or (self.pinned_convo_id is None and idx == 0):
                c_item.setState_(1)  # Checked
            switch_menu.addItem_(c_item)

        # Section 4: Quick Actions
        item_copy = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            self.t("copy_convo_id"), "copyConvoId:", "c"
        )
        item_copy.setTarget_(self)
        self.menu.addItem_(item_copy)

        item_finder = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            self.t("open_finder"), "openFinder:", "o"
        )
        item_finder.setTarget_(self)
        self.menu.addItem_(item_finder)

        item_refresh = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            self.t("refresh_now"), "manualRefresh:", "r"
        )
        item_refresh.setTarget_(self)
        self.menu.addItem_(item_refresh)

        # Section 5: Language Selection Submenu
        lang_menu = NSMenu.alloc().init()
        lang_parent = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            self.t("language_menu"), None, ""
        )
        lang_parent.setSubmenu_(lang_menu)
        self.menu.addItem_(lang_parent)

        for mode_code, title_key in [("auto", "lang_auto"), ("zh", "lang_zh"), ("en", "lang_en")]:
            l_item = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
                self.t(title_key), "selectLanguage:", ""
            )
            l_item.setRepresentedObject_(mode_code)
            l_item.setTarget_(self)
            if self.lang_mode == mode_code:
                l_item.setState_(1)
            lang_menu.addItem_(l_item)

        self.menu.addItem_(NSMenuItem.separatorItem())

        item_quit = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            self.t("quit"), "terminateApp:", "q"
        )
        item_quit.setTarget_(self)
        self.menu.addItem_(item_quit)

    def selectAutoTrack_(self, sender):
        self.pinned_convo_id = None
        self.pinned_convo_title = None
        self.refreshData(force=True, rebuild_menu_now=True)

    def selectConvo_(self, sender):
        cid = sender.representedObject()
        self.pinned_convo_id = cid
        for c in self.recent_conversations:
            if c["id"] == cid:
                self.pinned_convo_title = c["title"]
                break
        self.refreshData(force=True, rebuild_menu_now=True)

    def selectLanguage_(self, sender):
        mode = sender.representedObject()
        if mode in ("auto", "zh", "en"):
            self.lang_mode = mode
            try:
                NSUserDefaults.standardUserDefaults().setObject_forKey_(mode, "agy_language")
            except Exception:
                pass
            self.refreshData(force=True, rebuild_menu_now=True)

    def copyConvoId_(self, sender):
        if self.current_stats and "convo_id" in self.current_stats:
            pb = NSPasteboard.generalPasteboard()
            pb.clearContents()
            pb.setString_forType_(self.current_stats["convo_id"], NSPasteboardTypeString)

    def openFinder_(self, sender):
        if self.current_stats and "file" in self.current_stats:
            folder = os.path.dirname(self.current_stats["file"])
            NSWorkspace.sharedWorkspace().openFile_(folder)

    def manualRefresh_(self, sender):
        self.refreshData(force=True, rebuild_menu_now=True)

    def terminateApp_(self, sender):
        NSApp.terminate_(self)


def main():
    parser = argparse.ArgumentParser(description="agy-menubar: macOS Menu Bar Monitor for Antigravity")
    parser.add_argument("--version", "-v", action="version", version=f"agy-menubar {__version__}")
    parser.add_argument(
        "--lang",
        choices=["auto", "zh", "en"],
        default=None,
        help="Interface language (auto, zh, en)",
    )
    args = parser.parse_args()

    app = NSApplication.sharedApplication()
    delegate = AntigravityMenuBarApp.alloc().init()
    if args.lang:
        delegate.lang_mode = args.lang
    app.setDelegate_(delegate)
    app.run()


if __name__ == "__main__":
    main()
